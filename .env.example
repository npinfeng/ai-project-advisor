# ===== LLM API Keys =====
# OpenAI API Key（使用 OpenAI 模型时需要）
OPENAI_API_KEY=sk-xxx
# OpenAI-compatible endpoint（可选，默认 https://api.openai.com/v1）
OPENAI_BASE_URL=https://api.openai.com/v1
# DeepSeek API Key（使用 DeepSeek 模型时需要，OpenAI 兼容协议）
DEEPSEEK_API_KEY=sk-xxx
# DeepSeek Base URL（可选，默认 https://api.deepseek.com）
DEEPSEEK_BASE_URL=https://api.deepseek.com
# ANTHROPIC_API_KEY=sk-ant-xxx
# GOOGLE_API_KEY=xxx

# ===== Search API =====
TAVILY_API_KEY=tvly-xxx

# ===== GitHub API =====
# 如果不设置，GitHub API 请求会受到更严格的频率限制（每小时 60 次）
# 设置后提升至每小时 5000 次
GITHUB_TOKEN=ghp_xxx

# ===== 模型配置 =====
# 模型格式：<provider>:<model_name>
# DeepSeek 使用 deepseek: 前缀（底层为 OpenAI 兼容协议）
# 可用的 DeepSeek 模型：deepseek-chat（通用）, deepseek-reasoner（推理）

# 研究模型（用于 Agent 决策和工具调用）
RESEARCH_MODEL=deepseek:deepseek-chat
RESEARCH_MODEL_MAX_TOKENS=10000

# 受限 Reviewer 模型；最终 Markdown 报告由程序模板生成
FINAL_REPORT_MODEL=deepseek:deepseek-chat
FINAL_REPORT_MODEL_MAX_TOKENS=10000

# ===== Agent 配置 =====
# 最大并发研究单元数
MAX_CONCURRENT_RESEARCH_UNITS=5
# 每个研究员最大工具调用次数
MAX_REACT_TOOL_CALLS=10
# 单轮最多并行执行的 Tool 调用数，防止模型一次产生无界 fan-out
MAX_TOOL_CALLS_PER_STEP=5
# 单次模型请求、Tool 调用与整次 Agent Run 的硬超时（秒）
LLM_TIMEOUT_SECONDS=60
TOOL_TIMEOUT_SECONDS=45
AGENT_RUN_TIMEOUT_SECONDS=600
# Tool 仅对超时、连接失败、429/5xx 等瞬时错误重试
TOOL_MAX_RETRIES=1
TOOL_RETRY_BACKOFF_SECONDS=0.5
# 是否允许向用户追问
ALLOW_CLARIFICATION=true
# 结构化输出最大重试次数
MAX_STRUCTURED_OUTPUT_RETRIES=3
# Reviewer 证据总字符预算 / 单条证据最大字符数
REVIEWER_CONTEXT_MAX_CHARS=30000
REVIEWER_EVIDENCE_MAX_CHARS=3000

# Evidence 生命周期：超过 stale 阈值降级，超过 expire 阈值停止索引并可清理
EVIDENCE_STALE_AFTER_DAYS=180
EVIDENCE_EXPIRE_AFTER_DAYS=365

# ===== MCP 配置 =====
# 启用项目内置 stdio MCP Server
ENABLE_LOCAL_MCP=true
# MCP 失败时是否中断工作流；false 表示降级继续
MCP_REQUIRED=false
# 工具发现超时（秒）
MCP_CONNECT_TIMEOUT_SECONDS=20
# 两类 Research Agent 的 MCP 工具白名单；未列出的工具默认拒绝
REPOSITORY_MCP_TOOL_ALLOWLIST=
DOCUMENTATION_MCP_TOOL_ALLOWLIST=
# 额外 MCP Server 配置，必须是单行 JSON 对象；留空表示只使用内置 Server
# stdio 示例：{"docs":{"transport":"stdio","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","C:\\\\team-docs"]}}
# Streamable HTTP 示例：{"company":{"transport":"streamable_http","url":"https://mcp.example.com/mcp"}}
MCP_SERVERS_JSON=

# ===== 运行诊断与离线评测 =====
# 模型单价（USD / 1M Token）；保持 0 时页面不显示成本估算
INPUT_PRICE_PER_MILLION=0
OUTPUT_PRICE_PER_MILLION=0
# 默认读取 evals/real_results.json；可指定另一个评测结果文件
EVALUATION_FILE=

# ===== 任务与工作流持久化 =====
# 相对路径按项目根目录解析；本地/单机部署默认使用 SQLite
CHECKPOINT_DB_PATH=data/checkpoints.sqlite3
TASK_DB_PATH=data/tasks.sqlite3

# ===== Web 安全与资源保护 =====
# 公开或局域网部署时务必设置；浏览器页面可在“API 访问设置”中填写
ADVISOR_API_KEY=
# 单客户端每分钟高成本请求数
API_RATE_LIMIT_PER_MINUTE=20
# 单进程候选生成/深度评估的全局并发上限
MAX_CONCURRENT_EVALUATIONS=2
# 单次任务硬预算；0 表示不启用。成本上限依赖上面的 Token 单价配置
MAX_RUN_TOKENS=0
MAX_RUN_COST_USD=0
# 网页抓取只允许公网 HTTP/HTTPS；可选再限制为逗号分隔的域名及其子域名
WEB_FETCH_DOMAIN_ALLOWLIST=
MAX_WEB_RESPONSE_BYTES=2000000

# ===== 评分权重配置（总和应为 1.0）=====
WEIGHT_FEATURE_MATCH=0.30
WEIGHT_ENGINEERING_RELIABILITY=0.20
WEIGHT_COMMUNITY=0.15
WEIGHT_DOCUMENTATION=0.10
WEIGHT_LEARNING_COST=0.10
WEIGHT_EXTENSIBILITY=0.10
WEIGHT_DEPLOYMENT_COST=0.05
